ECR_REGISTRY=<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com
ECR_SPRING_REPOSITORY=career-wave-spring
ECR_FASTAPI_REPOSITORY=career-wave-fastapi
IMAGE_TAG=latest

SPRING_PROFILES_ACTIVE=prod
FASTAPI_ENV=prod

DB_URL=jdbc:postgresql://<POSTGRES_PRIVATE_IP>:5432/career_wave
DB_HOST=<POSTGRES_PRIVATE_IP>
DB_PORT=5432
DB_NAME=career_wave
DB_USERNAME=career_user
DB_PASSWORD=<DB_PASSWORD>

REDIS_HOST=<REDIS_PRIVATE_IP>
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>

WEBHOOK_SECRET=
JWT_SECRET=
OPENAI_API_KEY=

# 초기 관리자 계정 (선택) — login-id/email/password 모두 설정된 경우에만 최초 기동 시 자동 생성됨.
# 이미 해당 login-id의 관리자가 있으면 건너뜀. 비워두면 아무 계정도 생성하지 않음.
# NAME/ROLE은 비워두면 각각 "슈퍼관리자"/MASTER로 자동 대체됨.
# ROLE 허용값: MASTER, CS, BACKEND (다른 값 입력 시 MASTER로 대체)
INITIAL_ADMIN_LOGIN_ID=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_ROLE=
