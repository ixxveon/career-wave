# =====================
# Database (PostgreSQL)
# =====================
# docker-compose up -d 실행 후 아래 정보로 DBeaver 접속 가능
# Host: localhost / Port: DB_PORT / Database: DB_NAME / User: DB_USER
DB_NAME=careerwave
DB_USER=careerwave
DB_PASSWORD=
DB_PORT=5432

# =====================
# Backend (Spring Boot)
# =====================
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

FASTAPI_BASE_URL=http://localhost:8000
WEBHOOK_SECRET=

JWT_SECRET=

# =====================
# FastAPI
# =====================
OPENAI_API_KEY=
