# =====================
# Database (PostgreSQL)
# =====================
# docker-compose up -d 실행 후 아래 정보로 DBeaver 접속 가능
# Host: localhost / Port: DB_PORT / Database: DB_NAME / User: DB_USER
DB_NAME=careerwave
DB_USER=careerwave
DB_PASSWORD=
DB_PORT=5432

# =====================
# Redis
# =====================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# FastAPI가 Redis 연결에 사용 (REDIS_HOST:REDIS_PORT 조합)
REDIS_URL=redis://<REDIS_HOST>:<REDIS_PORT>/0
