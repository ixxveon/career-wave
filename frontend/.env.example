# Spring API base URL (기본값: 현재 origin, Vite 프록시 경유)
# 배포: https://api.careerwave.com
VITE_API_BASE_URL=

# Spring WebSocket base URL (기본값: VITE_API_BASE_URL에서 ws:// 변환)
# 배포: wss://api.careerwave.com
VITE_WS_BASE_URL=

# FastAPI base URL — LLM·STT·TTS 파이프라인 (HTTP)
# 로컬: http://localhost:8000 / 배포: https://ai.careerwave.com
VITE_FASTAPI_BASE_URL=

# FastAPI WebSocket base URL (기본값: VITE_FASTAPI_BASE_URL에서 ws:// 변환)
# 로컬: ws://localhost:8000 / 배포: wss://ai.careerwave.com
VITE_FASTAPI_WS_URL=

# Toss Payments
VITE_TOSS_CLIENT_KEY=
