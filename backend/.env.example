# =====================
# Database (PostgreSQL)
# =====================
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# =====================
# JWT
# =====================
JWT_USER_SECRET=
JWT_ADMIN_SECRET=

# =====================
# AWS S3 (미구현 — 추후 S3 연동 시 아래 값을 SES 섹션의 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY와 별도로 설정)
# =====================
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_MOCK_UPLOAD=true

# =====================
# Redis
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================
# FastAPI 연동
# =====================
FASTAPI_BASE_URL=http://localhost:8000
WEBHOOK_SECRET=

# =====================
# WebSocket
# =====================
WEBSOCKET_ALLOWED_ORIGINS=*

# =========================
# SOLAPI / CoolSMS
# =========================
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=

# =========================
# AWS SES
# =========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_SES_FROM_EMAIL=
# =====================
# Interview 내부 콜백 인증
# =====================
# FastAPI가 리포트 완료 콜백 호출 시 X-Internal-Secret 헤더로 전달하는 시크릿 값
# 로컬 개발 시 임의 값 설정, prod는 FastAPI 팀과 동일한 값으로 맞춰야 함
INTERVIEW_INTERNAL_SECRET=
