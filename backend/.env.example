# =====================
# Database (PostgreSQL)
# =====================
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# =====================
# JWT
# =====================
JWT_USER_SECRET=
JWT_ADMIN_SECRET=

# =====================
# 초기 관리자 계정 (선택) — login-id/email/password 모두 설정된 경우에만 최초 기동 시 자동 생성됨.
# 이미 해당 login-id의 관리자가 있으면 건너뜀. 비워두면 아무 계정도 생성하지 않음.
# =====================
INITIAL_ADMIN_LOGIN_ID=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_ROLE=

# =====================
# AWS Credentials (공통 — S3 및 SES에서 공유)
# =====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =====================
# AWS S3 (재직증명서 / 이력서 파일 저장 — 서울 리전)
# =====================
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-northeast-2
AWS_S3_MOCK_UPLOAD=true

# =====================
# AWS SES (이메일 인증번호 발송 — 시드니 리전)
# =====================
AWS_SES_REGION=ap-southeast-2
AWS_SES_FROM_EMAIL=

# =====================
# Redis
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================
# FastAPI 연동
# =====================
FASTAPI_BASE_URL=http://localhost:8000
WEBHOOK_SECRET=

# =====================
# WebSocket
# =====================
WEBSOCKET_ALLOWED_ORIGINS=*

# =========================
# SOLAPI / CoolSMS (SMS 인증번호 발송)
# =========================
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=

# =========================
# OAuth — Kakao
# =========================
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/user/members/oauth/kakao/callback

# =========================
# OAuth — Naver
# =========================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/v1/user/members/oauth/naver/callback

# =========================
# OAuth — Google
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/user/members/oauth/google/callback

# =========================
# NTS 국세청 사업자등록정보 상태조회 API (공공데이터포털)
# =========================
NTS_BUSINESS_API_BASE_URL=https://api.odcloud.kr/api/nts-businessman/v1
PUBLIC_DATA_NTS_SERVICE_KEY=

# =========================
# Toss Payments
# =========================
TOSS_BILLING_KEY_ENCRYPTION_KEY=
TOSS_SECRET_KEY=

# =========================
# Frontend URL (OAuth 콜백 redirect 대상 — 운영 환경에서는 반드시 실제 도메인으로 설정)
# =========================
FRONTEND_URL=http://localhost:5173

# =========================
# Cookie 보안 설정
# 로컬 HTTP 개발환경: false / 프로덕션 HTTPS: true
# =========================
COOKIE_SECURE=false

# 쿠키 Domain — 프론트(www)와 백엔드(api)가 다른 서브도메인일 때 ".careerwave.kr"로 공유.
# 로컬(단일 host)에서는 비워 둔다.
COOKIE_DOMAIN=

# =========================
# IpAclFilter 신뢰 프록시 (X-Forwarded-For를 신뢰할 프록시 IP/CIDR, 콤마 구분)
# 배포: Nginx EC2의 사설 IP. 로컬(프록시 없음)에서는 비워 둔다.
# =========================
TRUSTED_PROXY_IPS=
