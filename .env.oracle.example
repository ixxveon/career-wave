# Oracle VM에서 .env로 복사한 뒤 CHANGE_ME 값을 실제 값으로 변경

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=career_wave
DB_USERNAME=career_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_URL=jdbc:postgresql://postgres:5432/career_wave

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Internal services
SPRING_PROFILES_ACTIVE=prod
FASTAPI_ENV=prod
SPRING_BASE_URL=http://spring:8080
FASTAPI_BASE_URL=http://fastapi:8000
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
AI_METRICS_INTERNAL_BASE_URL=http://fastapi:8000/internal/admin/ai-metrics
AI_METRICS_INTERNAL_SECRET=CHANGE_ME_AI_METRICS_SECRET
AI_USAGE_LOG_TIMEOUT_SECONDS=2.0

# Authentication and security
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_USER_SECRET=CHANGE_ME_JWT_USER_SECRET
JWT_ADMIN_SECRET=CHANGE_ME_JWT_ADMIN_SECRET
PRIVACY_HASH_SECRET=CHANGE_ME_PRIVACY_HASH_SECRET
WEBSOCKET_ALLOWED_ORIGINS=*
TRUSTED_PROXY_IPS=

# Domain and cookies (HTTPS 적용 후 값 변경)
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
COOKIE_SECURE=false
COOKIE_DOMAIN=

# AWS S3 is not used on Oracle
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=careerwave-files
AWS_S3_BUCKET=careerwave-files
AWS_S3_REGION=ap-osaka-1
AWS_REGION=ap-osaka-1
AWS_S3_ENDPOINT=CHANGE_ME_OCI_S3_ENDPOINT
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_MOCK_UPLOAD=false
AWS_S3_PRESIGNED_URL_EXPIRATION_MINUTES=10
AWS_S3_FASTAPI_PRESIGNED_URL_EXPIRATION_MINUTES=60

# AWS SES (optional; leave empty if unused)
AWS_SES_REGION=ap-southeast-2
AWS_SES_FROM_EMAIL=

# Local file and vector storage
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BASE_PATH=/app/storage/rag-documents
VECTOR_STORE_PROVIDER=mock
VECTOR_STORE_COLLECTION=admin_ai_metrics_rag_documents
VECTOR_STORE_BASE_PATH=/app/storage/vector-store
AI_METRICS_RAG_STORAGE_BASE_PATH=/app/storage
WEBHOOK_OUTBOX_DB_PATH=/app/data/career-wave-webhook-outbox.db
DOCUMENT_BASE_DIR=/app/documents
VOICE_QUALITY_THRESHOLD=50.0
AUDIO_CHUNK_MAX_BYTES=5242880
REDIS_SESSION_TTL_SECONDS=300
REDIS_RATE_LIMIT_TTL_SECONDS=20

# OpenAI
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL_INTERVIEW=gpt-4o
OPENAI_MODEL_STT=whisper-1
OPENAI_MODEL_TTS=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_LLM_TIMEOUT_SECONDS=10

# OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# External APIs
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
NTS_BUSINESS_API_BASE_URL=https://api.odcloud.kr/api/nts-businessman/v1
PUBLIC_DATA_NTS_SERVICE_KEY=

# Toss Payments
TOSS_SECRET_KEY=
TOSS_BILLING_KEY_ENCRYPTION_KEY=CHANGE_ME_TOSS_BILLING_KEY_ENCRYPTION_KEY
TOSS_MOCK=true
TOSS_BASE_URL=https://api.tosspayments.com

# Billing reconciliation
BILLING_RECONCILIATION_MAX_MINUTES=30
BILLING_RECONCILIATION_BATCH_SIZE=50
BILLING_RECONCILIATION_INTERVAL_MS=300000
BILLING_RENEWAL_CONCURRENCY=20
BILLING_RENEWAL_TASK_TIMEOUT_SECONDS=30
RESUME_ANALYSIS_STUCK_THRESHOLD_MINUTES=30

# FastAPI AI Metrics tuning
RAG_CHUNK_TARGET_CHARS=1200
RAG_CHUNK_MAX_CHARS=1500
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_SECONDS=3.0

# Optional initial admin account
INITIAL_ADMIN_LOGIN_ID=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_ROLE=MASTER

# Frontend build variables (used when building the frontend separately)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_FASTAPI_BASE_URL=
VITE_FASTAPI_WS_URL=
VITE_TOSS_CLIENT_KEY=
VITE_COOKIE_DOMAIN=
VITE_USE_MOCK_DATA=false
