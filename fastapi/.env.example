# =====================
# Database (PostgreSQL)
# =====================
DATABASE_URL=postgresql://careerwave:@localhost:5432/careerwave

# =====================
# OpenAI
# =====================
OPENAI_API_KEY=
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =====================
# Spring 연동
# =====================
SPRING_BASE_URL=http://localhost:8080
WEBHOOK_SECRET=

# =====================
# AWS S3
# =====================
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BASE_PATH=./storage/rag-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# =====================
# Vector Store
# =====================
VECTOR_STORE_PROVIDER=mock
VECTOR_STORE_COLLECTION=admin_ai_metrics_rag_documents
VECTOR_STORE_BASE_PATH=./storage/vector-store
